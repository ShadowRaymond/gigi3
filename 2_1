#include <stdio.h>
#include <stdlib.h>
#include "../data_libs/data_io.h"
#include "decision.h"

int main() 
{
    double *data = NULL;
    int n = 0;
    
    if (input(&data, &n) != 0 || n <= 0) 
    {
        printf("n/a");
        if (data != NULL) 
        {
            free(data);
        }
        return 0;
    }
    
    if (make_decision(data, n)) 
    {
        printf("YES");
    } 
    else 
    {
        printf("NO");
    }
    
    free(data);
    return 0;
}
