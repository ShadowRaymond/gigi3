#include "s21_string.h"
#include <stdio.h>

void s21_strlen_test(const char *test_input, size_t expected_output);

int main()
{
    // Тест 1: Обычная строка (Нормальное значение)
    s21_strlen_test("Hello", 5);

    // Тест 2: Пустая строка (Краевое значение)
    s21_strlen_test("", 0);

    // Тест 3: Строка со спецсимволами и пробелами (Неординарное значение)
    s21_strlen_test("School 21\n!", 11);

    return 0;
}

void s21_strlen_test(const char *test_input, size_t expected_output)
{
    size_t result = s21_strlen(test_input);

    printf("INPUT: \"%s\"\n", test_input);
    printf("EXPECTED: %zu, GOT: %zu\n", expected_output, result);

    if (result == expected_output)
    {
        printf("SUCCESS\n\n");
    }
    else
    {
        printf("FAIL\n\n");
    }
}
