CC = gcc
CFLAGS = -Wall -Werror -Wextra
BUILD_DIR = ../../build

TARGET_6 = $(BUILD_DIR)/Quest_6
TARGET_7 = $(BUILD_DIR)/Quest_7

SRCS = s21_string.c s21_string_test.c
OBJS = $(SRCS:.c=.o)

all: strlen_tests strcmp_tests

strlen_tests:
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -DSTRLEN_MODE s21_string.c s21_string_test.c -o $(TARGET_6)

strcmp_tests:
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -DSTRCMP_MODE s21_string.c s21_string_test.c -o $(TARGET_7)

clean:
	rm -f *.o $(TARGET_6) $(TARGET_7)

rebuild: clean all

.PHONY: all strlen_tests strcmp_tests clean rebuild
