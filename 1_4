#include "data_io.h"
#include <stdio.h>
#include <stdlib.h>

int input(double **data, int *n) 
{
    if (scanf("%d", n) != 1 || *n <= 0) 
    {
        return 1;
    }
    
    *data = (double *)malloc((*n) * sizeof(double));
    if (*data == NULL) 
    {
        return 1;
    }
    
    for (int i = 0; i < *n; i++) 
    {
        if (scanf("%lf", (*data) + i) != 1) 
        {
            return 1;
        }
    }
    
    return 0;
}

void output(double *data, int n) 
{
    for (int i = 0; i < n; i++) 
    {
        printf("%.2f", *(data + i));
        if (i < n - 1) 
        {
            printf(" ");
        }
    }
}
