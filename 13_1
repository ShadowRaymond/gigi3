#include <stdio.h>
#include <stdlib.h>

#define MAX_TEXT 105
#define MAX_WORDS 100

int s21_strcmp(const char *str1, const char *str2);
int s21_strlen(const char *str);
void s21_strcpy(char *dest, const char *src);
int process_text(int width);
void justify_line(char words[MAX_WORDS][MAX_TEXT], int word_count, int line_len, int width, int is_last);

int main(int argc, char **argv)
{
    if (argc != 2 || s21_strcmp(argv[1], "-w") != 0)
    {
        printf("n/a");
        return 0;
    }

    int width;
    if (scanf("%d", &width) != 1 || width <= 0)
    {
        printf("n/a");
        return 0;
    }

    char c = getchar();
    while (c == ' ' || c == '\t')
    {
        c = getchar();
    }
    if (c != '\n' && c != EOF)
    {
        ungetc(c, stdin);
    }

    if (process_text(width) != 0)
    {
        printf("n/a");
    }

    return 0;
}

int s21_strcmp(const char *str1, const char *str2)
{
    while (*str1 && (*str1 == *str2))
    {
        str1++;
        str2++;
    }
    return *(const unsigned char *)str1 - *(const unsigned char *)str2;
}

int s21_strlen(const char *str)
{
    int len = 0;
    while (*(str + len) != '\0')
    {
        len++;
    }
    return len;
}

void s21_strcpy(char *dest, const char *src)
{
    while (*src != '\0')
    {
        *dest = *src;
        dest++;
        src++;
    }
    *dest = '\0';
}

int process_text(int width)
{
    char text[MAX_TEXT];
    int text_len = 0;
    char ch;

    while ((ch = getchar()) != '\n' && ch != EOF && text_len < MAX_TEXT - 1)
    {
        text[text_len++] = ch;
    }
    text[text_len] = '\0';

    if (text_len == 0)
    {
        return 0;
    }

    char raw_words[MAX_WORDS][MAX_TEXT];
    int raw_count = 0;
    int i = 0;

    while (text[i] != '\0')
    {
        while (text[i] == ' ' || text[i] == '\t')
        {
            i++;
        }
        if (text[i] == '\0')
        {
            break;
        }

        int w_len = 0;
        while (text[i] != ' ' && text[i] != '\t' && text[i] != '\0')
        {
            raw_words[raw_count][w_len++] = text[i++];
        }
        raw_words[raw_count][w_len] = '\0';
        raw_count++;
    }

    char words[MAX_WORDS][MAX_TEXT];
    int word_count = 0;

    for (int j = 0; j < raw_count; j++)
    {
        int len = s21_strlen(raw_words[j]);
        if (len <= width)
        {
            s21_strcpy(words[word_count++], raw_words[j]);
        }
        else
        {
            int curr = 0;
            while (len - curr > width)
            {
                int chunk = width - 1;
                int k;
                for (k = 0; k < chunk; k++)
                {
                    words[word_count][k] = raw_words[j][curr + k];
                }
                words[word_count][k++] = '-';
                words[word_count][k] = '\0';
                word_count++;
                curr += chunk;
            }
            int k = 0;
            while (raw_words[j][curr] != '\0')
            {
                words[word_count][k++] = raw_words[j][curr++];
            }
            words[word_count][k] = '\0';
            word_count++;
        }
    }

    int start = 0;
    while (start < word_count)
    {
        int end = start;
        int line_len = s21_strlen(words[start]);

        while (end + 1 < word_count && line_len + 1 + s21_strlen(words[end + 1]) <= width)
        {
            end++;
            line_len += 1 + s21_strlen(words[end]);
        }

        int is_last = (end == word_count - 1);
        char current_line_words[MAX_WORDS][MAX_TEXT];
        int current_line_count = 0;

        for (int k = start; k <= end; k++)
        {
            s21_strcpy(current_line_words[current_line_count++], words[k]);
        }

        justify_line(current_line_words, current_line_count, line_len, width, is_last);

        if (!is_last)
        {
            printf("\n");
        }
        start = end + 1;
    }

    return 0;
}

void justify_line(char words[MAX_WORDS][MAX_TEXT], int word_count, int line_len, int width, int is_last)
{
    if (word_count == 1 || is_last)
    {
        for (int i = 0; i < word_count; i++)
        {
            printf("%s", words[i]);
            if (i < word_count - 1)
            {
                printf(" ");
            }
        }
        return;
    }

    int total_spaces = width - (line_len - (word_count - 1));
    int spaces_per_gap = total_spaces / (word_count - 1);
    int extra_spaces = total_spaces % (word_count - 1);

    for (int i = 0; i < word_count; i++)
    {
        printf("%s", words[i]);
        if (i < word_count - 1)
        {
            int spaces_to_print = spaces_per_gap + (i < extra_spaces ? 1 : 0);
            for (int s = 0; s < spaces_to_print; s++)
            {
                printf(" ");
            }
        }
    }
}
